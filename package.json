{
  "name": "loom-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.check.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter './packages/*' publish --access public",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9",
    "@types/node": "^22.0.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "globals": "^15",
    "prettier": "^3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8",
    "vitest": "^2.1.0"
  }
}
